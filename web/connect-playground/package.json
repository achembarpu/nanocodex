{
  "name": "@nanocodex/connect-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --prefix ../../js/terminal",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy --config ./wrangler.jsonc"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "nanocodex": "file:../../js/bindings",
    "nanocodex-react": "file:../../js/react",
    "nanocodex-terminal": "file:../../js/terminal",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "4.123.0"
  }
}
