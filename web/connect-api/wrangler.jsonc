{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-connect-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "services": [
    { "binding": "ACCOUNTS", "service": "nanocodex-durable-agent" },
    { "binding": "EGRESS", "service": "nanocodex-egress" },
    { "binding": "NANOCODEX", "service": "nanocodex" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CONNECT_STATE", "class_name": "NonceStorage" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NonceStorage"] }
  ],
  "observability": { "enabled": true }
}
