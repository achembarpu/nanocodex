{
  "name": "nanocodex-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync": "node scripts/sync-nanocodex.mjs",
    "publish:repository": "node scripts/publish-repository.mjs",
    "wasm": "cd .. && just build-wasm",
    "predev": "npm run wasm",
    "dev": "CLOUDFLARE_ENV=development CLOUDFLARE_INCLUDE_PROCESS_ENV=true node --env-file-if-exists=../.env ./node_modules/vite/bin/vite.js dev",
    "test": "npm --prefix ../js/artifacts test && npm --prefix ../js/tui test && node --experimental-strip-types --test worker/*.test.ts test/*.test.ts scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "gen:types": "wrangler types",
    "prebuild": "npm run wasm",
    "build": "tsc --noEmit && vite build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "1.8.0",
    "@pierre/diffs": "1.2.12",
    "@pierre/theme": "^1.1.0",
    "@pierre/trees": "^1.0.0-beta.5",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-switch": "1.2.6",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.6",
    "accounts": "^0.16.0",
    "diff": "^9.0.0",
    "htm": "3.1.1",
    "isomorphic-git": "^1.41.5",
    "just-bash": "^3.4.0",
    "lucide-react": "^1.24.0",
    "minisearch": "7.2.0",
    "mppx": "^0.8.15",
    "nanocodex": "file:../js/bindings",
    "nanocodex-artifacts": "file:../js/artifacts",
    "nanocodex-react": "file:../js/react",
    "nanocodex-tui": "file:../js/tui",
    "nanocodex-tui-react": "file:../js/tui-react",
    "ox": "^0.14.33",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "^7.18.2",
    "recharts": "^3.10.1",
    "shiki": "^4.3.1",
    "streamdown": "^2.5.0",
    "viem": "^2.55.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vite-plugin-mkcert": "^1.17.12",
    "wrangler": "4.123.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "ws": "^8.21.3"
  }
}
