{
  "name": "nanocodex-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "sync": "node scripts/sync-nanocodex.mjs",
    "publish:repository": "node scripts/publish-repository.mjs",
    "wasm": "cd .. && just build-wasm",
    "dev:wasm": "npm run wasm",
    "dev:bootstrap": "npm ci --prefix ../js/bindings && npm ci --prefix ../js/terminal && npm run build --prefix ../js/terminal && npm ci --prefix ../services/egress && npm ci --prefix ../services/managed && npm run dev:wasm",
    "dev:rebuild": "npm run dev",
    "dev:containers": "NANOCODEX_DEV_CONTAINERS=1 npm run dev",
    "dev": "node scripts/dev-local.mjs",
    "dev:web": "npm run dev",
    "dev:api-key": "npm run dev",
    "dev:subscription": "npm run dev",
    "test": "npm --prefix ../js/artifacts test && node --experimental-strip-types --test worker/*.test.ts test/*.test.ts scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "gen:types": "wrangler types",
    "prebuild": "npm run wasm",
    "build": "tsc --noEmit && vite build && npm run check:docs",
    "build:from-wasm": "tsc --noEmit && vite build && npm run check:docs",
    "smoke:mcp": "node --experimental-strip-types scripts/smoke-mcp.mjs",
    "smoke:safari": "node scripts/safari-browser-smoke.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npm run deploy:built",
    "deploy:built": "node scripts/deploy-worker.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "1.8.0",
    "@pierre/diffs": "1.2.12",
    "@pierre/theme": "^1.1.0",
    "@pierre/trees": "^1.0.0-beta.5",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-switch": "1.2.6",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.6",
    "accounts": "0.16.2",
    "diff": "^9.0.0",
    "htm": "3.1.1",
    "isomorphic-git": "^1.41.5",
    "lucide-react": "^1.24.0",
    "minisearch": "7.2.0",
    "nanocodex": "file:../js/bindings",
    "nanocodex-react": "file:../js/react",
    "nanocodex-terminal": "file:../js/terminal",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.18.2",
    "recharts": "^3.10.1",
    "shiki": "^4.3.1",
    "viem": "^2.54.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "wrangler": "4.123.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "ws": "^8.21.3"
  }
}
