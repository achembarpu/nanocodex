{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "preserveSymlinks": true,
    "baseUrl": ".",
    "paths": {
      "nanocodex": ["../js/bindings/index.d.mts"],
      "nanocodex/browser": ["../js/bindings/browser/index.d.mts"],
      "nanocodex/browser/voice": ["../js/bindings/browser/Voice.d.mts"],
      "nanocodex/browser/workspace": ["../js/bindings/browser/workspace.d.mts"],
      "nanocodex/tools": ["../js/bindings/tools/index.d.mts"],
      "nanocodex/tools/artifact": ["../js/bindings/tools/artifact.d.mts"],
      "nanocodex/tools/browser": ["../js/bindings/tools/browser/index.d.mts"],
      "nanocodex/tools/vite": ["../js/bindings/tools/vite.d.mts"],
      "nanocodex/worker": ["../js/bindings/worker/index.d.mts"],
      "nanocodex-react": ["../js/react/index.d.mts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "worker", "vite.config.ts", "worker-configuration.d.ts"]
}
