{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-connect-api",
  "main": "./src/index.ts",
  "upload_source_maps": true,
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "services": [
    { "binding": "ACCOUNTS", "service": "nanocodex-durable-agent" },
    { "binding": "EGRESS", "service": "nanocodex-egress" },
    { "binding": "NANOCODEX", "service": "nanocodex" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CONNECT_STATE", "class_name": "ConnectNonceStorage" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NonceStorage"] },
    {
      "tag": "v2",
      "renamed_classes": [
        { "from": "NonceStorage", "to": "ConnectNonceStorage" }
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
