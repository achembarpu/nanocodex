{
  "name": "nanocodex-react",
  "version": "0.1.0",
  "description": "React state management for browser-embedded Nanocodex agents",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    },
    "./config": {
      "types": "./config.d.mts",
      "import": "./config.mjs"
    }
  },
  "files": [
    "config.d.mts",
    "config.mjs",
    "index.d.mts",
    "index.mjs",
    "README.md"
  ],
  "scripts": {
    "check:pack": "node scripts/check-pack.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run check:package",
    "test": "node --test test/*.test.mjs && npm run check:package && npm run check:pack"
  },
  "peerDependencies": {
    "nanocodex": "^0.4.0",
    "react": ">=18"
  },
  "devDependencies": {
    "nanocodex": "file:../bindings",
    "react": "19.2.6"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gakonst/nanocodex.git",
    "directory": "js/react"
  }
}
