{
  "name": "nanocodex-artifacts-react",
  "version": "0.1.0",
  "description": "Accessible React components for validated Nanocodex artifacts",
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:pack": "node scripts/check-pack.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build && npm run check:package",
    "test": "tsc --noEmit && npm run build && node --test test/*.test.mjs && npm run check:package && npm run check:pack"
  },
  "peerDependencies": {
    "nanocodex-artifacts": "^0.1.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "nanocodex-artifacts": "file:../artifacts",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gakonst/nanocodex.git",
    "directory": "js/artifacts-react"
  }
}
